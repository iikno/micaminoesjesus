{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:api": "node --watch server/index.js",
    "start": "node server/index.js",
    "migrate": "node server/migrate.js",
    "seed": "node --import ./server/seed-loader.js server/seed.js",
    "seed:sql": "node --import ./server/seed-loader.js server/cli/gen-seed-sql.js",
    "create-admin": "node server/cli/create-admin.js",
    "job:hourly": "node server/jobs/hourly.js",
    "test": "node --test server/test/",
    "db:up": "docker compose -f docker-compose.local.yml --env-file .env.local up -d --wait db",
    "db:down": "docker compose -f docker-compose.local.yml --env-file .env.local down"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "sharp": "^0.35.5",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
