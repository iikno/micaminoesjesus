# Names only. In production these live in the Coolify UI (Environment Variables), never in the repo or the image.
# Locally copy to .env.local (gitignored; the server loads ONLY .env.local or $ENV_FILE, never .env).
# Local values matching docker-compose.local.yml: DB_HOST=127.0.0.1 DB_PORT=3307 DB_USER=mcj DB_PASS=mcj_local_dev DB_NAME=mcj MAIL_DISABLED=1
# [R] = required in production (the server refuses to start without it), [O] = optional.

NODE_ENV=production                         # [R] production | development | test
PORT=3000                                   # [O] default 3000; Coolify "Ports Exposes" must match
PUBLIC_URL=https://micaminoesjesus.org      # [R] https://... no trailing path; drives Secure cookies, Origin check, mail links
TZ=America/Mexico_City                      # [O] process timezone for logs/cron (DB dates are stored in UTC)
SESSION_SECRET=                             # [R] >= 32 random chars (openssl rand -hex 32); changing it logs everyone out

DB_HOST=                                    # [R] external MySQL host (RDS endpoint, *.rds.amazonaws.com)
DB_PORT=3306                                # [O] default 3306
DB_USER=                                    # [R]
DB_PASS=                                    # [R]
DB_NAME=                                    # [R]
DB_SSL=1                                    # [O] 1 = TLS with the Amazon RDS CA; recommended for RDS, leave empty locally

SMTP_HOST=                                  # [R] unless MAIL_DISABLED=1 (never in production)
SMTP_PORT=587                               # [O] 587 (STARTTLS) or 465 (with SMTP_SECURE=1)
SMTP_SECURE=                                # [O] 1 only for port 465
SMTP_USER=                                  # [O]
SMTP_PASS=                                  # [O]
SMTP_FROM=no-reply@micaminoesjesus.org      # [O] sender; its domain needs SPF/DKIM/DMARC
ADMIN_USER=                                 # [O] email of the FIRST admin, created on the first start only if no admin exists yet (never overwrites). In production a weak/missing ADMIN_PASS then stops the boot
ADMIN_PASS=                                 # [O] its password (min 6 chars). Log in, change it in the panel (Cambiar contraseña) and REMOVE this variable from Coolify
ADMIN_NAME=                                 # [O] display name, default Administrador
MAIL_DISABLED=                              # [O] 1 = print mails instead of sending (tests/local only; rejected in production)
CONTACT_TO=                                 # [O] contact-form recipient; reply-to is the sender. Without it messages are only stored in the panel inbox

UPLOADS_DIR=/data/uploads                   # [O] persistent volume where uploaded images live (pub/ is served at /uploads, private/ never is); UPLOAD_DIR is the old name and still works
UPLOAD_MAX_MB=8                             # [O] max size of one uploaded image
DIST_DIR=./dist                             # [O] built SPA

# F4: registrations, contact form, reCAPTCHA v3
GC_SITE=                                    # [O] reCAPTCHA v3 site key (public, sent to the browser). Add the domain micaminoesjesus.org in the Google reCAPTCHA console
GC_SECRET=                                  # [O] reCAPTCHA v3 secret. In production the public forms refuse to work without it (fail closed); in development they skip the check
RECAPTCHA_MIN_SCORE=0.5                     # [O] minimum score 0-1; below it a registration is rejected and a contact message is stored as spam
REG_ENC_KEY=                                # [O] 32 bytes as 64 hex chars: openssl rand -hex 32. Encrypts emergency contact, guardian and allergies (AES-256-GCM). Without it registrations answer 503. LOSING IT MAKES THOSE DATA UNREADABLE; keep a copy in a password manager. Do not rotate it casually
ALLERGIES_ENABLED=                          # [O] 1 shows the allergies field + its separate health-data consent. Leave OFF until the legal entity and the privacy notice are final (launch blocker)
# RECAPTCHA_VERIFY_URL is test-only (a fake verify server) and is ignored when NODE_ENV=production.

# Later phases (accepted and validated as optional today)
CLAUDE=                                     # [O] Anthropic API key for the panel's automatic translation; without it the feature is off (English is typed by hand)
TRANSLATE_PROVIDER=claude                   # [O] only 'claude' exists today
TRANSLATE_MODEL=claude-haiku-5-5            # [O] small, fast model used for translation
TRANSLATE_MONTHLY_LIMIT=100000              # [O] characters of Spanish source text translated per month; over it the panel refuses

# S3_* are NOT read by the app today: DB backups are RDS automated backups/snapshots. Reserved for media later.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
