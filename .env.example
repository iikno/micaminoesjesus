# Names only. In production these live in the Coolify UI (runtime + secret), never in the repo or the image.
# Locally copy to .env.local (gitignored; the server loads ONLY .env.local or $ENV_FILE, never .env).
# Local values matching docker-compose.yml: DB_HOST=127.0.0.1 DB_PORT=3307 DB_USER=mcj DB_PASS=mcj_local_dev DB_NAME=mcj MAIL_DISABLED=1

NODE_ENV=production
PORT=3000
PUBLIC_URL=https://micaminoesjesus.org
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
SESSION_SECRET=          # >= 32 random chars; keys the hashing of sessions and tokens
MAIL_DISABLED=           # 1 = print mails instead of sending (tests, local)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@micaminoesjesus.org
UPLOAD_DIR=/data/uploads
DIST_DIR=./dist
# Later phases (validated as optional today)
CONTACT_TO=
GC_SITE=
GC_SECRET=
CLAUDE=                  # Anthropic API key, translation in F3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
